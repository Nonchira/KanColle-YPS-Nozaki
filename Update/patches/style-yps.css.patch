 /* == ul === */
+/* Match link controls to the adjacent input buttons, even after host CSS resets. */
+.yps-navi a.yps-toolbar-link {
+	display: inline-block;
+	box-sizing: border-box;
+	border: 1px solid #767676 !important;
+	border-radius: 2px;
+	background: #efefef !important;
+	color: #111 !important;
+	padding: 1px 6px;
+	font: 13.3333px Arial, sans-serif;
+	line-height: normal;
+	text-decoration: none !important;
+	vertical-align: baseline;
+	cursor: pointer;
+}
+.yps-navi a.yps-toolbar-link:hover { background: #e3e3e3 !important; border-color: #444 !important; }
+.yps-navi a.yps-toolbar-link:focus-visible { outline: 2px solid #176c8e; outline-offset: 2px; }
+.yps-navi #YPS_compass { cursor: pointer; }
 ul.markdown {
 	/* 箇条書き頭文字円盤. */
 	list-style: disc inside;
@@ -89,3 +107,16 @@
 	/* hover時に太字. */
 	font-weight:bold;
 }
+
+.yps-nozaki { white-space: nowrap; border: 0; padding: 0; margin: 0; background: transparent; color: inherit; }
+.yps-nozaki[hidden] { display: none; }
+.yps-nozaki > summary { cursor: pointer; font-weight: bold; }
+.yps-nozaki > summary.yps-nozaki-max { color: red; }
+.yps-nozaki-details { white-space: pre-wrap; margin: 4px 0 0 1em; }
+.yps-nozaki-fleet { margin: 0.5em 0; }
+.yps-nozaki-table { border-collapse: collapse; border: 0; font: inherit; white-space: nowrap; margin: 0 0 0.5em; }
+.yps-nozaki-table th, .yps-nozaki-table td { border: 0; background: transparent; padding: 0 0.6em; line-height: 1.2; }
+.yps-nozaki-table th { font-weight: bold; text-align: center; font-size: 0.8em; }
+.yps-nozaki-table td:first-child { text-align: center; min-width: 4em; }
+.yps-nozaki-table td:nth-child(2) { text-align: left; min-width: 5em; }
+.yps-nozaki-table td:nth-child(3) { text-align: left; }
